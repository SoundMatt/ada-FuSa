project Tests is

   for Languages use ("Ada");
   for Source_Dirs use ("../src", ".");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use "../bin";
   for Main use ("run_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnatwa",
         "-gnat2022",
         --  fusa#101: enables runtime checking of the Pre/Post contracts
         --  added to Fusa.Sha256/Fusa.Hmac (and any future ones) -- the
         --  test suite is the one build that actually exercises them,
         --  rather than the contracts being purely decorative until a
         --  future gnatprove run statically discharges them.
         "-gnata",
         "-fprofile-arcs",
         "-ftest-coverage",
         "-g",
         "-O0");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-fprofile-arcs");
   end Linker;

end Tests;
